SalesDetailTable =
FILTER (
    ADDCOLUMNS (
        'Ziegler Bolt and Parts House $ Item Ledger Entry',
        "Sales",           RELATED ( AVW_VESummed[Sales] ),
        "Cost",            RELATED ( AVW_VESummed[Cost] ),
        "Margin",          RELATED ( AVW_VESummed[Sales] ) - RELATED ( AVW_VESummed[Cost] ),
        "Customer No.",    'Ziegler Bolt and Parts House $ Item Ledger Entry'[Source No_],
        "Document No.",    'Ziegler Bolt and Parts House $ Item Ledger Entry'[Document No_],
        "Item No.",        'Ziegler Bolt and Parts House $ Item Ledger Entry'[Item No_],
        "Item Description",'Ziegler Bolt and Parts House $ Item'[Description],
        "Item Category Code",
                          'Ziegler Bolt and Parts House $ Item'[Item Category Code],
        "Product Group Code",
                          'Ziegler Bolt and Parts House $ Item'[Product Group Code],
        "Document Type",   'Ziegler Bolt and Parts House $ Item Ledger Entry'[Document Type],
        "Entry No.",       'Ziegler Bolt and Parts House $ Item Ledger Entry'[Entry No_],
        "Salesperson Code",           AVW_CreditsandShipmentsbysalesperson[Salesperson Code],
        "Inside Salesperson Code",    AVW_CreditsandShipmentsbysalesperson[Inside Salesperson Code],
        "Year",            YEAR ( AVW_VESummed[Posting Date] ),
        "Month",           MONTH ( AVW_VESummed[Posting Date] ),
        "No.",             AVW_CreditsandShipmentsbysalesperson[No_],
        "Inside Name",
            RELATED ( 'Ziegler Bolt and Parts House $ Salesperson_Purchaser'[Name] ),
        "Sales Location",
            'Ziegler Bolt and Parts House $ Item Ledger Entry'[Global Dimension 1 Code],
        "Outside Name",
            RELATED ( 'Ziegler Bolt and Parts House $ Salesperson_Purchaser_1'[Name] ),
        "Customer Name",
            RELATED ( 'Ziegler Bolt and Parts House $ Customer'[Name] ),
        "Date Opened",
            RELATED ( 'Ziegler Bolt and Parts House $ Customer'[Date Opened] ),
        "Address",
            RELATED ( 'Ziegler Bolt and Parts House $ Customer'[Address] ),
        "City",
            RELATED ( 'Ziegler Bolt and Parts House $ Customer'[City] ),
        "Phone No.",
            RELATED ( 'Ziegler Bolt and Parts House $ Customer'[Phone No_] ),
        "Shipment Method Code",
            AVW_CreditsandShipmentsbysalesperson[Shipment Method Code],
        "Shipping Agent Code",
            AVW_CreditsandShipmentsbysalesperson[Shipping Agent Code],
        "State",
            RELATED ( 'Ziegler Bolt and Parts House $ Customer'[County] ),
        "Zip Code",
            RELATED ( 'Ziegler Bolt and Parts House $ Customer'[Post Code] )
    ),
    'Ziegler Bolt and Parts House $ Item Ledger Entry'[Entry Type] = 1
)
